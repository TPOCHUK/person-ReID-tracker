# Copy to .env. Relative paths use the project folder.
YOLO_MODEL=yolov8n.pt
REID_MODEL=yolo26n-reid.onnx
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
DEVICE=cpu
HALF=false
IMGSZ=256
TORCH_THREADS=2
CV_THREADS=1
YOLO_TRACKER=bytetrack.yaml
DETECTOR_CONF=0.25
CONF_THRESHOLD=0.6
SIMILARITY_THRESHOLD=0.7
MAX_LOST_FRAMES=30
REID_UPDATE_INTERVAL=10
REID_UPDATE_CONF=0.8
REID_RECOVERY_INTERVAL=5
REID_RECOVERY_START=5
REID_EMBEDDING_ALPHA=0.2
RECOVERY_MAX_CANDIDATES=8
JPEG_QUALITY=70
STREAM_MAX_FPS=15
BENCHMARK_OUTPUT_DIR=benchmark_results
